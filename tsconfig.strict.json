{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["jest", "node", "react-native"]
    },
    "include": [
        "src/env.ts",
        "storefront.extensions.ts",
        "brand/**/*.ts",
        "brand/**/*.tsx",
        "src/extensions/**/*.ts",
        "src/extensions/**/*.tsx",
        "__tests__/extensions/**/*.ts",
        "__tests__/extensions/**/*.tsx",
        "src/network/**/*.ts",
        "src/branding/**/*.ts",
        "src/preview/**/*.ts",
        "__tests__/preview/**/*.ts",
        "__tests__/branding/**/*.ts",
        "__tests__/network/**/*.ts",
        "src/commerce/**/*.ts",
        "__tests__/commerce/**/*.ts",
        "src/ui/**/*.ts",
        "src/ui/**/*.tsx",
        "__tests__/ui/**/*.ts",
        "src/utils/google-maps.ts",
        "src/utils/web-column.ts",
        "src/utils/web-device.ts",
        "src/utils/stripe-web.ts",
        "src/navigation/web-linking.ts",
        "__tests__/navigation/web-linking.test.ts",
        "__tests__/web/**/*.ts",
        "src/components/map/RouteDirections.tsx",
        "__tests__/maps/**/*.ts",
        "__tests__/maps/**/*.tsx"
    ],
    "exclude": [
        "src/extensions/app-screen-registry.tsx",
        "src/extensions/screens/default-screens.ts",
        "src/extensions/screens/ScreenFallbacks.tsx",
        "src/branding/assets.ts",
        "src/branding/build-branding.ts",
        "legacy",
        "node_modules",
        "ios/Pods"
    ]
}
